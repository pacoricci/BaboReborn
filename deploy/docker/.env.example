COMPOSE_PROJECT_NAME=baboreborn
# External PostgreSQL: compose.yaml
# Local PostgreSQL: compose.yaml + compose.postgres.yaml (see deployment guide).
# Keep the database URL in secrets/central/database-url, not in this file.
# Optional mount overrides:
# CENTRAL_CONFIG_DIR=./secrets/central
# SERVER_CONFIG_DIR=./secrets/server
# POSTGRES_PASSWORD_FILE=./secrets/postgres-password # Local database only.
CENTRAL_ORIGIN=https://portal.example.org
CENTRAL_PORT=443
# Register the community as https://game.example.org:8443 with these defaults.
SERVER_PORT=8443
# Host addresses for the published ports; 0.0.0.0 listens on all interfaces.
CENTRAL_BIND=0.0.0.0
SERVER_BIND=0.0.0.0
CENTRAL_IMAGE=baboreborn/central:local
SERVER_IMAGE=baboreborn/server:local
# Only during first association or recovery; clear after confirmation.
PAIRING_CODE_FILE=

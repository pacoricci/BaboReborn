COMPOSE_PROJECT_NAME=baboreborn
CENTRAL_ORIGIN=https://portal.example.org
CENTRAL_PORT=443
# Register the community as https://game.example.org:8443 with these defaults.
SERVER_PORT=8443
# Host addresses for the published ports; 0.0.0.0 listens on all interfaces.
CENTRAL_BIND=0.0.0.0
SERVER_BIND=0.0.0.0
CENTRAL_IMAGE=baboreborn/central:local
SERVER_IMAGE=baboreborn/server:local
# Only during first association or recovery; clear after confirmation.
PAIRING_CODE_FILE=
